\centering
\caption{Cross-Reference of Page Clustered Superpaging Terms and Codebase Macro Equivalents}
\label{tab:clustering_terms}
\begin{tabularx}{0.9\textwidth}{l X X}
\toprule
\textbf{Concept} & \textbf{Symbol} \\
\midrule
$n$-th Superpage Size & $g_n$ (\emph{Seitengröße}) \\
Superpage Order Increment & $W$ (\emph{Sprungweite}) \\
Superpage Increase Factor & $F$ (\emph{Sprungfaktor}) \\
First Non-Trivial Superpage Order & $\Omega$ \\
