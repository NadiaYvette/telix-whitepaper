\centering
\caption{Cross-Reference of Page Clustering Terms and Codebase Macro Equivalents}
\label{tab:clustering_terms}
\begin{tabularx}{0.9\textwidth}{l X X}
\toprule
\textbf{Concept} & \textbf{Symbol} & \textbf{Dickins / Telix Proto} \\
\midrule
Mapping Granularity (Hardware) & $K$ (\emph{K\"ornung}) & \texttt{MMUPAGE\_SIZE} \\
Allocation Unit (Physical) & $Z$ (\emph{Zuteilungseinheit}) & \texttt{PAGE\_SIZE} \\
Fragment Count per Allocation & $B$ (\emph{Bruchst\"uckanzahl}) & \texttt{PAGE\_MMUCOUNT} \\
